{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 120,
      "minLength": 0
    },
    "spaceId": {
      "type": "string",
      "format": "uuid"
    },
    "role": {
      "type": "string",
      "maxLength": 80,
      "minLength": 0
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "read",
          "write",
          "publish"
        ],
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "expiry": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "expiry",
    "name",
    "role",
    "scopes",
    "spaceId"
  ]
}
