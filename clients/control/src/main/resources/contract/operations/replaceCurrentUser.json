{
  "example": {
    "params": {},
    "privateParams": false,
    "json": {
      "avatar": "VALUE",
      "locale": "VALUE",
      "name": "VALUE"
    },
    "privateBody": false
  },
  "operationId": "replaceCurrentUser",
  "apiCommand": "control.account.replace",
  "description": "Replace the authenticated user profile with a complete representation. Every declared profile field, including nullable locale and avatar, must be supplied; null clears the value. Verify with control.account.get.",
  "method": "PUT",
  "path": "/api/v1/me",
  "parameters": [],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/ReplaceProfileRequest"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "description": "Replaced profile",
      "content": {
        "*/*": {
          "schema": {
            "$ref": "#/components/schemas/Profile"
          }
        }
      }
    },
    "400": {
      "description": "A required replacement field is missing",
      "content": {
        "*/*": {
          "schema": {
            "$ref": "#/components/schemas/Profile"
          }
        }
      }
    },
    "422": {
      "description": "Blank name or non-HTTPS avatar (profile_invalid)",
      "content": {
        "application/problem+json": {
          "schema": {
            "$ref": "#/components/schemas/ApiProblem"
          }
        }
      }
    },
    "401": {
      "description": "Missing, expired or revoked session (authentication_required)",
      "content": {
        "application/problem+json": {
          "schema": {
            "$ref": "#/components/schemas/ApiProblem"
          }
        }
      }
    }
  },
  "capabilities": {
    "jsonInput": true,
    "binaryInput": false,
    "binaryOutput": false,
    "pagination": false,
    "confirmation": false,
    "invocation": true,
    "secretInput": false,
    "secretOutput": false
  },
  "credentialTypes": [
    "session"
  ],
  "requiredScopes": [],
  "mutates": true,
  "highImpact": false,
  "idempotencyMode": "explicit-single-attempt"
}
