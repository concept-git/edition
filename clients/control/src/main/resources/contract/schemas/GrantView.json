{
  "type": "object",
  "properties": {
    "resource": {
      "$ref": "#/components/schemas/ResourceView"
    },
    "principal": {
      "$ref": "#/components/schemas/PrincipalView"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "maintainer",
        "author",
        "reader",
        "none"
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "read",
          "write",
          "publish",
          "admin"
        ]
      }
    },
    "editable": {
      "type": "boolean"
    },
    "allowedActions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "grant",
          "override",
          "set_none",
          "change_role",
          "revoke",
          "explain",
          "restrict",
          "replace_restriction",
          "narrow_restriction",
          "unrestrict"
        ]
      }
    }
  }
}
