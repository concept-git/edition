{
  "example": {
    "params": {},
    "privateParams": false,
    "json": {
      "newPassword": "VALUE",
      "oldPassword": "VALUE"
    },
    "privateBody": true
  },
  "operationId": "changePassword",
  "apiCommand": "control.account.password.change",
  "description": "Change the authenticated user's password. Verify with control.account.get.",
  "method": "POST",
  "path": "/api/v1/me/password:change",
  "parameters": [],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/ChangeRequest"
        }
      }
    },
    "required": true
  },
  "responses": {
    "204": {
      "description": "Password changed; all sessions ended"
    },
    "400": {
      "description": "Old password invalid (invalid_old_password)",
      "content": {
        "application/problem+json": {
          "schema": {
            "$ref": "#/components/schemas/ApiProblem"
          }
        }
      }
    },
    "422": {
      "description": "New password too weak (password_too_weak)",
      "content": {
        "application/problem+json": {
          "schema": {
            "$ref": "#/components/schemas/ApiProblem"
          }
        }
      }
    },
    "429": {
      "description": "Password locked (password_locked)",
      "headers": {
        "Retry-After": {
          "description": "Seconds until the current password may be attempted again",
          "style": "simple",
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "content": {
        "application/problem+json": {
          "schema": {
            "$ref": "#/components/schemas/ApiProblem"
          }
        }
      }
    }
  },
  "capabilities": {
    "jsonInput": true,
    "binaryInput": false,
    "binaryOutput": false,
    "pagination": false,
    "confirmation": false,
    "invocation": true,
    "secretInput": true,
    "secretOutput": false
  },
  "credentialTypes": [
    "session"
  ],
  "requiredScopes": [],
  "mutates": true,
  "highImpact": false,
  "idempotencyMode": "explicit-single-attempt"
}
