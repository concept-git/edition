{
  "name": "edition-control-console",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "generate": "node scripts/generate-api.mjs",
    "check:contract": "node scripts/generate-api.mjs --check",
    "check": "tsc --noEmit && pnpm check:contract && pnpm check:coverage && node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:browser": "playwright test --config playwright.config.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run src/shared/api src/features/page-authoring/domain",
    "check:coverage": "node scripts/check-coverage.mjs",
    "test:mutation": "stryker run",
    "check:duplication": "jscpd src/features src/app src/shared/api/*.ts --ignore **/generated/**,**/*.test.ts --reporters console,json --threshold 3 --output coverage/duplication"
  },
  "dependencies": {
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "7.0.7",
    "@platejs/autoformat": "53.0.0",
    "@platejs/basic-nodes": "53.0.0",
    "@platejs/basic-styles": "53.0.0",
    "@platejs/code-block": "53.0.0",
    "@platejs/combobox": "53.0.0",
    "@platejs/dnd": "53.3.8",
    "@platejs/floating": "^53.0.0",
    "@platejs/footnote": "^53.0.0",
    "@platejs/indent": "^53.0.0",
    "@platejs/link": "53.3.5",
    "@platejs/list": "53.3.13",
    "@platejs/markdown": "53.5.3",
    "@platejs/media": "53.1.4",
    "@platejs/resizable": "^53.0.0",
    "@platejs/selection": "53.1.6",
    "@platejs/table": "53.0.9",
    "@platejs/utils": "53.5.2",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-toolbar": "^1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.108.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "9.3.1",
    "@udecode/cn": "52.3.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "codemirror": "6.0.2",
    "esbuild-wasm": "0.28.2",
    "lodash": "^4.18.1",
    "lowlight": "^3.3.0",
    "lucide-react": "1.77.0",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "platejs": "53.5.2",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-resizable-panels": "4.24.1",
    "recharts": "3.11.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1",
    "tailwind-scrollbar-hide": "^4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/lodash": "4.17.27",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "jscpd": "5.4.3",
    "jsdom": "31.0.1",
    "msw": "3.0.7",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
