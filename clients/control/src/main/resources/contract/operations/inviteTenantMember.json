{
  "example": {
    "params": {
      "tenantId": "00000000-0000-0000-0000-000000000001"
    },
    "privateParams": false,
    "json": {
      "email": "agent@example.test",
      "role": "owner"
    },
    "privateBody": false
  },
  "operationId": "inviteTenantMember",
  "apiCommand": "control.tenants.invitations.create",
  "description": "Invite someone to the tenant. Verify with control.tenants.capability.get.",
  "method": "POST",
  "path": "/api/v1/tenants/{tenantId}/invitations",
  "parameters": [
    {
      "name": "tenantId",
      "in": "path",
      "required": true,
      "schema": {
        "type": "string",
        "format": "uuid"
      }
    },
    {
      "name": "Idempotency-Key",
      "in": "header",
      "description": "Stable key for this user action (1-255 characters)",
      "required": true,
      "schema": {
        "type": "string",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9._:-]+$"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/InviteRequest"
        }
      }
    },
    "required": true
  },
  "responses": {
    "201": {
      "description": "Invitation issued",
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/TenantIssuedInvitation"
          }
        }
      }
    },
    "400": {
      "description": "Missing or invalid Idempotency-Key (invalid_idempotency_key)",
      "content": {
        "application/problem+json": {
          "schema": {
            "$ref": "#/components/schemas/ApiProblem"
          }
        }
      }
    },
    "409": {
      "description": "Already a member (already_member), key reused for another request (idempotency_key_reused), or a request is still processing (idempotency_request_in_progress)",
      "content": {
        "application/problem+json": {
          "schema": {
            "$ref": "#/components/schemas/ApiProblem"
          }
        }
      }
    },
    "422": {
      "description": "Unknown role (member_role_invalid)",
      "content": {
        "application/problem+json": {
          "schema": {
            "$ref": "#/components/schemas/ApiProblem"
          }
        }
      }
    },
    "401": {
      "description": "Missing, expired or revoked session (authentication_required)",
      "content": {
        "application/problem+json": {
          "schema": {
            "$ref": "#/components/schemas/ApiProblem"
          }
        }
      }
    },
    "403": {
      "description": "Not a tenant admin (permission_denied) or tenant frozen (tenant_suspended)",
      "content": {
        "application/problem+json": {
          "schema": {
            "$ref": "#/components/schemas/ApiProblem"
          }
        }
      }
    }
  },
  "capabilities": {
    "jsonInput": true,
    "binaryInput": false,
    "binaryOutput": false,
    "pagination": false,
    "confirmation": false,
    "invocation": true,
    "secretInput": false,
    "secretOutput": true
  },
  "credentialTypes": [
    "session",
    "management_token"
  ],
  "requiredScopes": [
    "members:write"
  ],
  "mutates": true,
  "highImpact": false,
  "idempotencyMode": "server-key"
}
