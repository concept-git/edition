  "operationId": "requestBundleExport",
  "apiCommand": "control.spaces.exports.create",
  "description": "Queue a complete portable ZIP for a retained live or archived release. Verify with control.spaces.exports.get. Export job ready, then downloaded ZIP bytes exist and match intended release.",
  "method": "POST",
  "path": "/api/v1/tenants/{tenantId}/spaces/{spaceId}:export",
  "parameters": [
    {
      "name": "tenantId",
      "in": "path",
      "required": true,
      "schema": {
        "type": "string",
        "format": "uuid"
      }
    },
    {
      "name": "spaceId",
      "in": "path",
      "required": true,
      "schema": {
        "type": "string",
        "format": "uuid"
      }
    },
    {
      "name": "Idempotency-Key",
      "in": "header",
      "required": true,
      "schema": {
        "type": "string",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9._:-]+$"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/BundleExportRequest"
        }
      }
    },
    "required": true
  },
  "responses": {
    "202": {
      "description": "Accepted",
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BundleExportJob"
          }
        }
      }
    }
  },
  "capabilities": {
    "jsonInput": true,
    "binaryInput": false,
