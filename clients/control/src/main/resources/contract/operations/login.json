    "json": {
      "email": "agent@example.test",
      "password": "VALUE"
    },
    "privateBody": true
  },
  "operationId": "login",
  "apiCommand": "control.auth.bootstrap.login",
  "description": "Exchange credentials for an access token.",
  "method": "POST",
