{
  "name": "space-reading",
  "type": "module",
  "version": "7.2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/production-build.mjs",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "node scripts/check-architecture.mjs && node --test tests/*.test.mjs",
    "check": "astro check && pnpm check:reader",
    "check:reader": "astro check --config astro.reader.config.ts --tsconfig tsconfig.reader.json && node scripts/check-architecture.mjs",
    "dev:reader": "astro dev --config astro.reader.config.ts",
    "build:reader": "pnpm check:reader && astro build --config astro.reader.config.ts",
    "start:reader": "node dist-reader/server/entry.mjs"
  },
  "dependencies": {
    "@a2ui/lit": "0.14.0",
    "@a2ui/web_core": "0.14.0",
    "@alenaksu/json-viewer": "^2.1.2",
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/node": "^11.1.13",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@hyperjump/browser": "1.6.0",
    "@hyperjump/json-schema": "1.18.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.8",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.18",
    "lit": "^3.3.3",
    "lodash.kebabcase": "^4.1.1",
    "marked": "^18.2.1",
    "rehype-callouts": "^2.2.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "sanitize-html": "^2.18.2",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@pagefind/default-ui": "^1.6.0",
    "@shikijs/transformers": "^4.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "pagefind": "^1.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3"
  },
  "private": true,
  "packageManager": "pnpm@11.10.0"
}
