  "operationId": "createRedirect",
  "apiCommand": "control.redirects.set",
  "description": "Create or replace a redirect to a Space mounted on this Site, or a page in that Space. Verify with control.redirects.list.",
  "method": "POST",
  "path": "/api/v1/tenants/{tenantId}/sites/{siteId}/redirects",
  "parameters": [
    {
      "name": "tenantId",
      "in": "path",
      "required": true,
      "schema": {
        "type": "string",
        "format": "uuid"
      }
    },
    {
      "name": "siteId",
      "in": "path",
      "required": true,
      "schema": {
        "type": "string",
        "format": "uuid"
      }
    },
    {
      "name": "Idempotency-Key",
      "in": "header",
      "required": true,
      "schema": {
        "type": "string",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9._:-]+$"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/CreateRedirectRequest"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "description": "Current redirect rule",
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/RedirectView"
          }
        }
      }
    }
  },
  "capabilities": {
    "jsonInput": true,
    "binaryInput": false,
    "binaryOutput": false,
    "pagination": false,
    "confirmation": false,
    "invocation": true,
    "secretInput": false,
    "secretOutput": false
  },
  "credentialTypes": [
    "session",
    "management_token"
  ],
  "requiredScopes": [
    "hosting:write"
  ],
  "mutates": true,
  "highImpact": false,
  "idempotencyMode": "server-key"
}
