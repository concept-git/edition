{
  "example": {
    "params": {
      "id": "00000000-0000-0000-0000-000000000001"
    },
    "privateParams": false
  },
  "operationId": "retryMailJob",
  "apiCommand": "control.mailJobs.retry",
  "description": "Replay the original failed mail intent. Verify with control.mailJobs.list.",
  "method": "POST",
  "path": "/ops/mail-jobs/{id}:retry",
  "parameters": [
    {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
        "type": "string",
        "format": "uuid"
      }
    },
    {
      "name": "tenantId",
      "in": "query",
      "required": false,
      "schema": {
        "type": "string",
        "format": "uuid"
      }
    },
    {
      "name": "Idempotency-Key",
      "in": "header",
      "required": true,
      "schema": {
        "type": "string",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9._:-]+$"
      }
    }
  ],
  "requestBody": {},
  "responses": {
    "200": {
      "description": "Original mail job state after retry request",
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/MailJob"
          }
        }
      }
    }
  },
  "capabilities": {
    "jsonInput": false,
    "binaryInput": false,
    "binaryOutput": false,
    "pagination": false,
    "confirmation": false,
    "invocation": true,
    "secretInput": false,
    "secretOutput": false
  },
  "credentialTypes": [
    "session",
    "management_token"
  ],
  "requiredScopes": [
    "operations:write"
  ],
  "mutates": true,
  "highImpact": false,
  "idempotencyMode": "server-key"
}
