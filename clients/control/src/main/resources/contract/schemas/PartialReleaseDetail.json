{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "label": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "flagged",
        "validated",
        "live",
        "archived"
      ]
    },
    "source": {
      "$ref": "#/components/schemas/PartialReleaseSource"
    },
    "pageCount": {
      "type": "integer",
      "format": "int32"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "promotedAt": {
      "type": "string",
      "format": "date-time"
    },
    "allowedActions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "string"
    },
    "report": {
      "$ref": "#/components/schemas/PartialReportView"
    },
    "diffSummary": {
      "$ref": "#/components/schemas/PartialDiffSummary"
    },
    "size": {
      "type": "integer",
      "format": "int64"
    }
  }
}
