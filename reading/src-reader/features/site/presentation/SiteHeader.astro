---
import type { Site } from "../domain/site.ts";
import { languageOf } from "../domain/site.ts";

interface Props {
  site: Site;
  currentSpace?: string;
}
const { site, currentSpace } = Astro.props;
const zh = languageOf(site) === "zh-CN";
const spaces = site.spaces.filter((space) => space.navigation.length > 0);
---

<header class="site-header">
  <a class="site-brand" href="/">
    {site.logo && <img src={site.logo} alt="" />}
    <span>{site.name}</span>
  </a>
  {
    spaces.length > 0 && (
      <nav class="space-menu" aria-label={zh ? "可访问空间" : "Available spaces"}>
        {spaces.map((space) => (
          <a
            href={`/${space.slug}`}
            aria-current={space.slug === currentSpace ? "page" : undefined}
          >
            {space.name}
          </a>
        ))}
      </nav>
    )
  }
  <div class="site-tools"><slot name="tools" /></div>
</header>
