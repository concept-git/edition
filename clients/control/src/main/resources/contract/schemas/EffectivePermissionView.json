{
  "type": "object",
  "properties": {
    "principal": {
      "$ref": "#/components/schemas/PrincipalView"
    },
    "allowed": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "enum": [
        "direct_grant",
        "team_grant",
        "explicit_none",
        "no_grant",
        "restriction_miss"
      ]
    },
    "effectiveOperations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "read",
          "write",
          "publish",
          "admin"
        ]
      }
    },
    "matchedLayer": {
      "$ref": "#/components/schemas/ResourceView"
    },
    "matchedGrants": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/EffectiveGrantView"
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/DecisionTraceView"
      }
    }
  }
}
